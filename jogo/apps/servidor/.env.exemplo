# Copie para .env e ajuste. Sem .env o servidor sobe com os valores padrão abaixo.

# Porta e endereço do servidor.
PORTA=3001
HOST=127.0.0.1

# Banco. Vazio = PGlite (Postgres embutido) gravando em PASTA_BANCO, sem instalar nada.
# Em produção, aponte para um Postgres de verdade:
# DATABASE_URL=postgres://terna:terna@localhost:5432/terna
DATABASE_URL=
PASTA_BANCO=./dados/banco

# Endereços de onde o cliente pode chamar a API (separados por vírgula). O Vite em
# desenvolvimento já repassa /api, então isto só importa com o cliente em outro endereço.
ORIGENS_PERMITIDAS=http://localhost:5173

# Quantos dias uma sessão (login) vale.
DIAS_SESSAO=30

# 1 quando o servidor roda atrás de um proxy (Render): o IP do jogador vem do X-Forwarded-For.
CONFIAR_PROXY=0

# E-mails com o código de confirmação do cadastro e da troca de senha, pelo Brevo (grátis até 300
# por dia). A chave sai de brevo.com → SMTP & API → API Keys; o remetente precisa estar verificado
# em Senders, Domains & Dedicated IPs → Senders. Sem os dois, o e-mail não sai: o código aparece
# no terminal do servidor (bom para testar em casa).
BREVO_API_KEY=
EMAIL_REMETENTE=
NOME_REMETENTE=Terna

# Endereço do jogo publicado: a logo dos e-mails vem de lá (URL_DO_JOGO/email/logo.png).
URL_DO_JOGO=https://terna.pages.dev

# As contas mestre (tudo liberado para testar), separadas por vírgula. Vazio: só a oficial,
# ternaofcl@gmail.com.
EMAILS_MESTRE=
